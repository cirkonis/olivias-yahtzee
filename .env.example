# === Auth ===
# Secret used to encrypt the session cookie. Generate with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# The shared password that unlocks saved games and series (ask Mike).
NUXT_APP_PASSWORD=

# === Database (Neon Postgres) ===
# Pooled connection string from Neon / Vercel Marketplace integration.
POSTGRES_URL=

# Non-pooling URL (used by drizzle-kit for migrations).
POSTGRES_URL_NON_POOLING=
